{
  "name": "logixo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://0ashutosh1.github.io/logixo-website",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp -r dist/* docs/",
    "build:win": "vite build && xcopy dist docs /E /I /Y",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build:win",
    "deploy": "gh-pages -d dist",
    "deploy:docs": "npm run build:win && git add docs && git commit -m \"Update GitHub Pages\" && git push"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}
